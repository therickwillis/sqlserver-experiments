# Example environment variables for bee-admin.py
# Either set DB_CONN_STRING directly or set the parts below.
# DB_CONN_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost,1433;DATABASE=EnchantedBees;UID=sa;PWD=yourpassword
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost,1433
DB_DATABASE=EnchantedBees
# DB_USER=sa
# DB_PASSWORD=yourpassword
# Or on Windows with trusted connection, leave DB_USER/DB_PASSWORD unset
PORT=5000
