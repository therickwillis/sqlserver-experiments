{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build My Database",
			"type": "shell",
			"options": {
				"shell": {
					"executable": "powershell",
					"args": [
						"-NoLogo",
						"-NoProfile",
						"-ExecutionPolicy",
						"Bypass",
						"-Command"
					]
				}
			},
			"command": "dotnet build",
			"problemMatcher": "$sqlproj-problem-matcher",
			"isBackground": true,
			"group": {
				"kind": "build",
				"isDefault": "true"
			},
			"detail": "Builds the SQL project"
		}
	]
}