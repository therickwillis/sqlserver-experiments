CONTAINER_NAME=enchanted-bees-sqlserver
EXTERNAL_PORT=1433
HOST_VOLUME=./data
PASSWORD=YourSecurePassword123!
# Architecture-specific SQL Server image:
# Mac (ARM64): mcr.microsoft.com/azure-sql-edge:latest
# Windows/Intel (AMD64): mcr.microsoft.com/mssql/server:2022-latest
SQL_IMAGE=mcr.microsoft.com/azure-sql-edge:latest
MSSQL_PID=Developer
